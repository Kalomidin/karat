# karat-server. A phone on the same Wi-Fi uses this Mac's address, not 127.0.0.1.
# An Android emulator uses http://10.0.2.2:8080.
KARAT_API=http://127.0.0.1:8080

# Web client id. Android sign-in sends this. Not the Android client id.
GOOGLE_SERVER_CLIENT_ID=

# iOS client id. The same id also stays in ios/Runner/Info.plist.
GOOGLE_IOS_CLIENT_ID=
